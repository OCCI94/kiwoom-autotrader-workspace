      "derivation": "C9/C10 도메인과 C11 URL을 결합"
    },
    "steps": [
      {
        "step": 1,
        "text": "사용할 환경의 도메인과 /oauth2/token을 결합합니다.",
        "source_cells": [
          "C9",
          "C10",
          "C11"
        ]
      },
      {
        "step": 2,
        "text": "POST와 application/json;charset=UTF-8을 사용합니다.",
        "source_cells": [
          "C8",
          "C12",
          "C13"
        ]
      },
      {
        "step": 3,
        "text": "Body의 필수 String 필드 grant_type, appkey, secretkey를 입력합니다. grant_type은 client_credentials입니다.",
        "source_cells": [
          "B18",
          "D18",
          "E18",
          "G18",
          "B19",
          "D19",
          "E19",
          "B20",
          "D20",
          "E20"
        ]
      },
      {
        "step": 4,
        "text": "응답 Body의 expires_dt, token_type, token을 확인합니다. 세 필드 모두 Required Y입니다.",
        "source_cells": [
          "B23",
          "E23",
          "B24",
          "E24",
          "B25",
          "E25"
        ]
      }
    ]
  },
